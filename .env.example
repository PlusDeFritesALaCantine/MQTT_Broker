# Port série de l'Arduino : /dev/ttyACM0 ou /dev/ttyUSB0 sur Linux, COMx sur Windows.
PORT_SERIES=/dev/ttyACM0
BAUD_RATE=9600
MQTT_BROKER=localhost
MQTT_PORT=1883
# Topic publié par CE pont série (un seul Arduino = un seul pays/entrepôt à la fois).
MQTT_TOPIC=bresil/entrepot1/mesures
# Topic écouté par subscriber.py : wildcard sur pays+entrepôt pour couvrir les 3 pays.
MQTT_TOPIC_MESURES=+/+/mesures
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/iot_data
